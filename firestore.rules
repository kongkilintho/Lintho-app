rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // ແຍກການດຶງຂໍ້ມູນອອກມາເພື່ອບໍ່ໃຫ້ເກີດການ Loop
    // ✅ Fallback ປອດໄພ: ຖ້າ users/{uid} doc ບໍ່ມີ ຫຼື ບໍ່ມີ field role
    // (ເຊັ່ນ ຜູ້ໃຊ້ສະໝັກຜ່ານ Google ທີ່ doc ຍັງສ້າງບໍ່ສົມບູນ) ໃຫ້ສົ່ງຄືນ 'customer'
    // ແທນທີ່ຈະ error ແລ້ວເຮັດໃຫ້ rule ທັງ block deny ດ້ວຍ permission-denied
    function getRole() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) && ('role' in get(path).data)
        ? get(path).data.role
        : 'customer';
    }

    function isAdmin() {
      return isAuth() && getRole() == 'admin';
    }

    // 🔒 [AUDIT ADM-5 / 2026-07-30] getRole()/isAdmin() only know the coarse
    // users/{uid}.role=='admin' flag — the 5-tier AdminRole model
    // (super_admin/operations_admin/finance_admin/support_admin/marketing_admin)
    // used by lintho-admin's ROLE_PERMISSIONS lives in a separate
    // users/{uid}.adminRole field that, until now, had NO meaning to these
    // rules at all (every admin could write anything, regardless of tier).
    // Returns null for non-admins so a caller can never accidentally use this
    // without also being gated by admin status. Legacy admin accounts with no
    // adminRole field default to 'super_admin' — same fallback already used by
    // functions/index.js's _assertSuperAdmin() and lintho-admin's
    // src/lib/api/realAuth.ts resolveAdminRole(), so an existing admin account
    // is never locked out by this change.
    function getAdminRole() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuth() && exists(path) && get(path).data.role == 'admin'
        ? (('adminRole' in get(path).data) ? get(path).data.adminRole : 'super_admin')
        : null;
    }

    function isCustomer() {
      return isAuth() && getRole() == 'customer';
    }

    function isProvider() {
      return isAuth() && getRole() == 'provider';
    }

    // 🔒 [AUDIT QA-1 / ME-4] isProvider() ພຽງແຕ່ກວດ role ທີ່ user ຕັ້ງເອງຕອນ
    // ສະໝັກ — ບໍ່ກວດ KYC — ໝາຍຄວາມວ່າບັນຊີ provider ໃໝ່/ຍັງບໍ່ຜ່ານກວດ ສາມາດ
    // ອ່ານ PII (ຊື່/ເບີ/ທີ່ຢູ່/ຮູບ) ຂອງລູກຄ້າທຸກຄົນຜ່ານ open job board ໄດ້.
    // ຕອນນີ້ເພີ່ມການກວດ providers/{uid}.kycStatus == 'verified' ນຳ.
    function isVerifiedProvider() {
      return isProvider() &&
        exists(/databases/$(database)/documents/providers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/providers/$(request.auth.uid)).data.kycStatus == 'verified';
    }

    // 🔒 [AUDIT N-01 / 2026-08-08 — Critical, notification E2E audit] fcm_queue's
    // old create rule only checked document SHAPE (sent==false, targetUserId is
    // string) — not sender authority or any relationship to the target. Any
    // authenticated customer/provider could enqueue a doc with an arbitrary
    // targetUserId and type:'admin_broadcast', and processFCMQueue (Cloud
    // Function, functions/index.js) would blindly dispatch a real FCM push
    // indistinguishable from a genuine admin broadcast — full notification
    // spoofing against any user. The only legitimate client-side callers are
    // NotificationSender.chatMessage/reviewReceived/additionalCharges
    // (fcm_service.dart) — each one is always tied to a real booking, sent by
    // one party of that booking, targeting the other party. This function
    // verifies exactly that relationship so those 3 flows keep working while
    // everything else (including any 'admin_broadcast' from a non-admin) is
    // rejected. get() results for the same path are cached within one rule
    // evaluation, so referencing the booking doc twice below doesn't cost an
    // extra document-access call.
    function fcmBookingAuthorized(bookingId, targetUserId) {
      let bpath = /databases/$(database)/documents/bookings/$(bookingId);
      return bookingId is string && bookingId != '' &&
        exists(bpath) &&
        (get(bpath).data.customerId == request.auth.uid ||
          get(bpath).data.providerId == request.auth.uid) &&
        (get(bpath).data.customerId == targetUserId ||
          get(bpath).data.providerId == targetUserId) &&
        targetUserId != request.auth.uid;
    }

    // ກວດຄ່າ lat/lng ໃຫ້ຖືກປະເພດ ແລະ ຢູ່ໃນຂອບເຂດທີ່ເປັນໄປໄດ້
    // (ໃຊ້ໃນ booking create) — ອະນຸຍາດໃຫ້ບໍ່ມີ lat/lng ໄດ້ (ກໍລະນີລູກຄ້າພິມທີ່ຢູ່ເອງ
    // ບໍ່ໄດ້ກົດ GPS) ແຕ່ຖ້າມີຄ່າມາ ຕ້ອງເປັນ number ແລະ ຢູ່ໃນຂອບເຂດທີ່ຖືກຕ້ອງ
    function isValidLatLng() {
      return !('lat' in request.resource.data) ||
        request.resource.data.lat == null ||
        (request.resource.data.lat is number &&
         request.resource.data.lng is number &&
         request.resource.data.lat >= -90 && request.resource.data.lat <= 90 &&
         request.resource.data.lng >= -180 && request.resource.data.lng <= 180);
    }

    // ກວດ lat/lng ສະເພາະເວລາມີການແກ້ໄຂ field ນັ້ນ (ໃຊ້ກັບ providers
    // ບ່ອນທີ່ lat/lng ບໍ່ໄດ້ຢູ່ໃນທຸກ write — ເຊັ່ນ profile-only update)
    function isValidLatLngIfChanged() {
      return !('lat' in request.resource.data.diff(resource.data).affectedKeys()) ||
        (request.resource.data.lat is number && request.resource.data.lng is number &&
         request.resource.data.lat >= -90 && request.resource.data.lat <= 90 &&
         request.resource.data.lng >= -180 && request.resource.data.lng <= 180);
    }

    // 🔒 [AUDIT QA-1 / CR-3, CR-4] ກ່ອນໜ້ານີ້ booking create ບໍ່ໄດ້ກວດ
    // status/paymentStatus ຫຼືຂອບເຂດລາຄາເລີຍ — modified client ສາມາດສົ່ງ
    // status:'completed', paymentStatus:'paid', price:0 (ຫຼືສູງເກີນຈິງ) ໄດ້
    // ໂດຍກົງ. ຕອນນີ້ບັງຄັບວ່າ booking ໃໝ່ຕ້ອງເລີ່ມຕົ້ນເປັນ status='pending',
    // paymentStatus='pending', ແລະ price ຕ້ອງເປັນຕົວເລກທີ່ບໍ່ຕິດລົບ ແລະ ຢູ່ໃນ
    // ຂອບເຂດທີ່ເປັນໄປໄດ້ (ບໍ່ແມ່ນການຄິດໄລ່ລາຄາຄືນທັງໝົດຝັ່ງ server — ນັ້ນຕ້ອງການ
    // Cloud Function ແຍກຕ່າງຫາກ — ແຕ່ພຽງພໍປ້ອງກັນຄ່າ 0/ຕິດລົບ/ສູງເກີນຈິງແບບຊັດເຈນ).
    // 'price' ຖືກຂຽນໂດຍທັງສອງ flow ສະເໝີ (booking_form_screen.dart,
    // quick_booking_provider.dart) — 'grandTotal' ຂຽນສະເພາະ flow ຫຼັກ
    // (Quick Booking ບໍ່ມີ field ນີ້), ຈຶ່ງກວດແບບມີເງື່ອນໄຂ (optional) ເພື່ອບໍ່ໃຫ້
    // Quick Booking booking ທຸກອັນຖືກ deny (Firestore rules throw error ຕອນ
    // access key ທີ່ບໍ່ມີ, ບໍ່ແມ່ນ return null).
    //
    // ✅ providerId ອະນຸຍາດໃຫ້ມີມາໄດ້ຕອນ create (booking_form_screen.dart ຮັບ
    // ຄ່າ providerId ຕອນລູກຄ້າຈອງຊ່າງສະເພາະຄົນໂດຍກົງ — ເບິ່ງ
    // provider_details_screen.dart:751) — ບໍ່ໄດ້ເປັນຊ່ອງໂຫວ່ ເພາະ status ຖືກ
    // ບັງຄັບເປັນ 'pending' ຢູ່ແລ້ວຂ້າງເທິງ, providerId ນັ້ນຍັງຕ້ອງຜ່ານຂັ້ນຕອນ
    // acceptBooking() (transaction, booking_repository.dart) ຂອງຊ່າງເອງ ຈຶ່ງຈະ
    // ປ່ຽນເປັນ 'accepted' ໄດ້ — ບໍ່ແມ່ນການຂ້າມຂັ້ນຕອນຮັບງານແຕ່ຢ່າງໃດ.
    // 🔒 [AUDIT H-4 / 2026-07-27] address/landmark/specialInstructions ບໍ່ເຄີຍ
    // ຖືກກວດ type/size ຢູ່ rule ນີ້ເລີຍ (ມີແຕ່ client-side maxLength, ເບິ່ງ
    // booking_form_screen.dart, ເຊິ່ງເປັນແຕ່ cosmetic). Booking.fromFirestore()
    // (Booking.dart) ອ່ານ field ເຫຼົ່ານີ້ດ້ວຍ `as String?` ເຊິ່ງ throw ຖ້າຄ່າເປັນ
    // non-null non-String (ບໍ່ແມ່ນ coerce) — modified client / manual edit
    // ສ້າງ doc ທີ່ address ເປັນ number/map ໄດ້, ເຮັດໃຫ້ stream
    // .map(Booking.fromFirestore) throw ແລະ ວຽກທັງໝົດຂອງ provider ທຸກຄົນຫາຍໄປ
    // (ເບິ່ງ booking_repository.dart watchOpenJobs()). ຕອນນີ້ບັງຄັບ type ຢູ່ rule
    // ນຳ (defense-in-depth ຄຽງຄູ່ກັບ Booking.fromFirestore ທີ່ຖືກເຮັດໃຫ້ປອດໄພ
    // ຂຶ້ນນຳ, ເບິ່ງ _str() helper).
    function isValidBookingTextFields() {
      return (!('address' in request.resource.data) ||
          (request.resource.data.address is string &&
           request.resource.data.address.size() <= 500)) &&
        (!('landmark' in request.resource.data) ||
          (request.resource.data.landmark is string &&
           request.resource.data.landmark.size() <= 300)) &&
        (!('specialInstructions' in request.resource.data) ||
          (request.resource.data.specialInstructions is string &&
           request.resource.data.specialInstructions.size() <= 1000));
    }

    // 🔒 [AUDIT M-4 / 2026-07-27] `contactPhone` (ເບີໂທຢືນຢັນ OTP ຈາກບັນຊີ,
    // ເບິ່ງ Booking.dart) ຖືກ copy ຈາກ FirebaseAuth.currentUser.phoneNumber
    // ຝັ່ງ client ຕອນສ້າງ booking — ບໍ່ມີການກວດຄືນຝັ່ງ server ວ່າກົງກັບເບີໂທຈິງ
    // ຂອງບັນຊີທີ່ login ຢູ່. modified client ສາມາດຂຽນເບີໂທໃດກໍໄດ້ໃສ່ field ນີ້.
    // ຕອນນີ້ບັງຄັບວ່າຖ້າ contactPhone ມີມາ ຕ້ອງກົງກັບ request.auth.token.phone_number
    // ຂອງບັນຊີທີ່ login ຢູ່ — ຍົກເວັ້ນເວລາ phone_number claim ບໍ່ມີເລີຍ (ບັນຊີທີ່
    // login ຜ່ານຊ່ອງທາງອື່ນທີ່ບໍ່ແມ່ນເບີໂທ, ຖ້າມີໃນອະນາຄົດ) ເພື່ອບໍ່ໃຫ້ block flow
    // ທີ່ຖືກຕ້ອງ.
    // 🔒 [FIX] ກ່ອນໜ້ານີ້ `request.auth.token.phone_number == null` throw
    // evaluation error (ບໍ່ໄດ້ຄືນ null) ຖ້າ token ບໍ່ມີ claim ນີ້ເລີຍ (ບັນຊີ
    // login ຜ່ານ Google/email ທີ່ບໍ່ເຄີຍຜ່ານ Firebase Phone Auth) — ຕ່າງຈາກ
    // ຄອມເມັນ/ຈຸດປະສົງເດີມຂ້າງເທິງ. ຜົນຄື booking create ທຸກອັນ (ທັງ
    // booking_form_screen.dart ແລະ quick_booking_provider.dart ຂຽນ
    // contactPhone ສະເໝີ) ຖືກ deny ດ້ວຍ permission-denied ສຳລັບບັນຊີໃດກໍໄດ້ທີ່
    // ບໍ່ເຄີຍຢືນຢັນເບີໂທແທ້ — ຢືນຢັນຜ່ານ Firestore emulator (rules-unit-testing):
    // "Property phone_number is undefined on object." ຕອນນີ້ກວດ key existence
    // ກ່ອນດ້ວຍ 'in' (ບໍ່ throw ຖ້າບໍ່ມີ, ຄືກັນກັບ pattern ອື່ນໆໃນ file ນີ້).
    function isValidContactPhone() {
      return !('contactPhone' in request.resource.data) ||
        !('phone_number' in request.auth.token) ||
        request.auth.token.phone_number == null ||
        request.resource.data.contactPhone == request.auth.token.phone_number;
    }

    // 🔒 [AUDIT BE-1 / 2026-07-30] openToAll ຕ້ອງກົງກັບການມີ/ບໍ່ມີ providerId
    // ຕອນສ້າງ booking — customer ບໍ່ສາມາດປອມໃຫ້ booking ທີ່ຈອງຊ່າງສະເພາະຄົນ
    // (providerId ຖືກຕັ້ງແລ້ວ) ກາຍເປັນ "ເປີດໃຫ້ທຸກຄົນເຫັນ" (openToAll:true) ໄດ້,
    // ຫຼືກົງກັນຂ້າມ. ເບິ່ງ isOpenOrTargeted() ຂ້າງລຸ່ມສຳລັບຄວາມໝາຍ field ນີ້.
    function isValidOpenToAllFlag() {
      return request.resource.data.openToAll is bool &&
        (
          (!('providerId' in request.resource.data) || request.resource.data.providerId == '')
            ? request.resource.data.openToAll == true
            : request.resource.data.openToAll == false
        );
    }

    // 🔒 [AUDIT EDGE-1 / 2026-08-06] scheduledAt ບໍ່ເຄີຍຖືກກວດຢູ່ rule ນີ້ເລີຍ —
    // booking_form_screen.dart/quick_booking_screen.dart ກວດແຕ່ຝັ່ງ client
    // (picked.isBefore(DateTime.now())) ເທົ່ານັ້ນ, modified client ສາມາດຂຽນ
    // scheduledAt ໃນອະດີດໄດ້ໂດຍກົງ. ຍົກເວັ້ນເວລາ isNow==true (ຂຽນຄ່າຜ່ານ
    // FieldValue.serverTimestamp(), ອາດ resolve ໄວກວ່າ request.time ໜ້ອຍໜຶ່ງ
    // ຕາມລຳດັບການປະເມີນ) — ກວດສະເພາະກໍລະນີຈອງລ່ວງໜ້າ (isNow==false), ອະນຸຍາດ
    // grace period 5 ນາທີເພື່ອບໍ່ໃຫ້ block ການຈອງ "ອີກໜ້ອຍນາທີ" ທີ່ຜູ້ໃຊ້ໃຊ້ເວລາ
    // ຕື່ມແບບຟອມຫຼາຍກວ່ານັ້ນໜ້ອຍໜຶ່ງ.
    function isValidScheduledAt() {
      return !('scheduledAt' in request.resource.data) ||
        request.resource.data.isNow == true ||
        (request.resource.data.scheduledAt is timestamp &&
         request.resource.data.scheduledAt >= request.time - duration.value(5, 'm'));
    }

    function isValidNewBookingShape() {
      return request.resource.data.status == 'pending' &&
        request.resource.data.paymentStatus == 'pending' &&
        request.resource.data.price is number &&
        request.resource.data.price >= 0 && request.resource.data.price <= 50000000 &&
        (!('grandTotal' in request.resource.data) ||
          (request.resource.data.grandTotal is number &&
           request.resource.data.grandTotal >= 0 && request.resource.data.grandTotal <= 50000000)) &&
        isValidBookingTextFields() && isValidContactPhone() && isValidOpenToAllFlag() &&
        isValidScheduledAt();
    }

    // 🔒 [AUDIT QA-1 / HI-2] ກ່ອນໜ້ານີ້ update ບໍ່ໄດ້ກວດຄ່າ/transition ຂອງ
    // status ເລີຍ — customer ຫຼື provider ສາມາດຂຽນ status='completed' ໂດຍກົງ
    // ໂດຍທີ່ paymentStatus ຍັງບໍ່ເຄີຍເປັນ 'paid' (guard ນີ້ຢູ່ໃນ Flutter client
    // ເທົ່ານັ້ນ, booking_repository.dart:152), ເຮັດໃຫ້ onBookingStatusChange
    // ຝາກເງິນເຂົ້າ wallet ຊ່າງໃຫ້ວຽກທີ່ບໍ່ເຄີຍຈ່າຍເງິນ. ຕອນນີ້ບັງຄັບວ່າຖ້າ status
    // ໃໝ່ຈະເປັນ 'completed', paymentStatus ສຸດທ້າຍຕ້ອງເປັນ 'paid' ນຳ.
    // 🔒 [AUDIT ADM-1 / 2026-07-30] ເດີມ check ນີ້ firing ທຸກຄັ້ງທີ່ resulting
    // doc ມີ status=='completed', ບໍ່ວ່າ write ນີ້ຈະປ່ຽນ status ແທ້ ຫຼື ບໍ່ — ໝາຍ
    // ຄວາມວ່າ admin refund (ຕັ້ງໃຈບໍ່ແຕະ status ເລີຍ, ພຽງແຕ່ປ່ຽນ paymentStatus
    // ຈາກ 'paid' ເປັນ 'refunded' ໃສ່ booking ທີ່ status ຍັງເປັນ 'completed' ຄືເກົ່າ)
    // ຈະຖືກ rule ນີ້ block ຢ່າງບໍ່ຖືກຕ້ອງ. ຕອນນີ້ jscheck ນີ້ກວດສະເພາະຕອນ status
    // ແທ້ໆຖືກປ່ຽນຢູ່ໃນ write ນີ້ (ຄືຄວາມໝາຍເດີມ: "completion transition ຕ້ອງມາພ້ອມ
    // paymentStatus:'paid'"), ບໍ່ແມ່ນ invariant ຕະຫຼອດໄປຂອງ doc ທີ່ completed ແລ້ວ.
    function isValidCompletionPayment() {
      return !('status' in request.resource.data.diff(resource.data).affectedKeys()) ||
        request.resource.data.status != 'completed' ||
        (('paymentStatus' in request.resource.data) &&
         request.resource.data.paymentStatus == 'paid');
    }

    // 🔒 [AUDIT C-1 / 2026-07-27] ກ່ອນໜ້ານີ້ບໍ່ມີການກວດ status *transition*
    // ເລີຍ — ມີແຕ່ isValidCompletionPayment() (ຂ້າງເທິງ) ທີ່ກວດວ່າ resulting
    // doc ຕ້ອງມີ paymentStatus=='paid' ຖ້າ status ຈະເປັນ 'completed', ແຕ່ບໍ່ໄດ້
    // ກວດວ່າ status ເກົ່າແມ່ນຫຍັງ. ໝາຍຄວາມວ່າ provider ທີ່ຜ່ານ isVerifiedProvider()
    // ສາມາດຮັບງານ (status:'pending'→providerId=self) ພ້ອມຂຽນ
    // status:'completed', paymentStatus:'paid' ໃນ write ດຽວກັນໄດ້ໂດຍກົງ — ຂ້າມ
    // onTheWay/arrived/inProgress ທັງໝົດ — ແລ້ວ onBookingStatusChange (Cloud
    // Function) ຈະຝາກເງິນເຂົ້າ wallet ຊ່າງທັນທີ ໂດຍບໍ່ມີວຽກແທ້ເກີດຂຶ້ນເລີຍ. ຕອນນີ້
    // ບັງຄັບວ່າ status ຕ້ອງປ່ຽນຕາມລຳດັບຈິງເທົ່ານັ້ນ (state machine), ຂ້າມຂັ້ນຕອນ
    // ບໍ່ໄດ້ — ຄືກັນກັບ job_workflow_Screen.dart ບັງຄັບຢູ່ client ຢູ່ແລ້ວ, ຕອນນີ້
    // ບັງຄັບຊ້ຳຢູ່ rule ນຳ (defense-in-depth, ບໍ່ໄວ້ວາງໃຈ client ຝ່າຍດຽວ).
    function isValidBookingStatusTransition() {
      return !('status' in request.resource.data.diff(resource.data).affectedKeys()) ||
        (resource.data.status == 'pending' &&
          request.resource.data.status in ['accepted', 'cancelled', 'rejected']) ||
        (resource.data.status == 'accepted' &&
          request.resource.data.status in ['onTheWay', 'cancelled']) ||
        (resource.data.status == 'onTheWay' &&
          request.resource.data.status in ['arrived', 'cancelled']) ||
        (resource.data.status == 'arrived' &&
          request.resource.data.status in ['inProgress', 'cancelled']) ||
        (resource.data.status == 'inProgress' &&
          request.resource.data.status in ['completed', 'cancelled']);
    }

    // 🔒 [AUDIT C-1/H-3 / 2026-07-27] BCEL (ໂອນເງິນ) counter-confirmation
    // (customerConfirmedPayment, ເບິ່ງ FOLLOWUP-K ຂ້າງລຸ່ມ) ຖືກກວດຢູ່ Dart client
    // ເທົ່ານັ້ນ (booking_repository.dart confirmPaymentReceived(), ບໍ່ແມ່ນ rule
    // ນີ້) — modified client / REST call ໂດຍກົງສາມາດຂຽນ paymentStatus:'paid'
    // ໂດຍບໍ່ຜ່ານການຢືນຢັນຈາກລູກຄ້າເລີຍ. ຕອນນີ້ບັງຄັບຢູ່ rule ນຳ: paymentStatus
    // ຈະປ່ຽນເປັນ 'paid' ໄດ້ສະເພາະຖ້າ paymentMethod=='cash' (self-attested,
    // ຍອມຮັບເປັນຂໍ້ຈຳກັດເນື່ອງຈາກບໍ່ມີ payment gateway ແທ້) ຫຼື
    // customerConfirmedPayment==true ຢູ່ແລ້ວ (ລູກຄ້າຢືນຢັນມາກ່ອນໜ້ານີ້ໃນ write
    // ແຍກຕ່າງຫາກ — confirmPaymentSent()). ໃຊ້ resource.data (ຄ່າກ່ອນ write ນີ້)
    // ບໍ່ແມ່ນ request.resource.data ເພື່ອບໍ່ໃຫ້ provider ຂຽນ
    // customerConfirmedPayment:true ພ້ອມກັນໃນ write ດຽວກັນໄດ້ (field ນັ້ນຢູ່ໃນ
    // list ຂອງ customer ເທົ່ານັ້ນຢູ່ແລ້ວ, ນີ້ເປັນການປ້ອງກັນຊ້ຳ).
    function isValidPaymentTransition() {
      return !('paymentStatus' in request.resource.data.diff(resource.data).affectedKeys()) ||
        request.resource.data.paymentStatus != 'paid' ||
        resource.data.paymentMethod == 'cash' ||
        resource.data.customerConfirmedPayment == true;
    }

    // 🔒 [AUDIT H-2 / 2026-07-27] "sentTo" (Top-3 provider ທີ່ match_screen.dart
    // ເລືອກສົ່ງຄຳຂໍໃຫ້, ເບິ່ງ FOLLOWUP-H) ຖືກກວດຢູ່ Dart client ເທົ່ານັ້ນ
    // (isJobVisibleToProvider(), booking_provider.dart) — rule ອ່ານ/ຮັບງານ
    // ບໍ່ເຄີຍອ້າງອີງ field ນີ້ເລີຍ. ໝາຍຄວາມວ່າ provider ຄົນໃດກໍໄດ້ທີ່ຜ່ານ
    // isVerifiedProvider() ສາມາດ query bookings ໂດຍກົງ (ຂ້າມ UI filter) ເພື່ອອ່ານ
    // PII ລູກຄ້າ (ຊື່/ເບີ/ທີ່ຢູ່/ຕຳແໜ່ງ) ຂອງທຸກ pending job ທົ່ວແອັບ, ບໍ່ແມ່ນສະເພາະ
    // 3 ຄົນທີ່ຖືກເລືອກ, ແລະ ຮັບງານທີ່ບໍ່ໄດ້ຖືກສົ່ງໃຫ້ຕົນເອງໄດ້. ຕອນນີ້ບັງຄັບຢູ່
    // rule ນຳທັງອ່ານແລະຮັບງານ — sentTo ຫວ່າງເປົ່າ/ບໍ່ມີ = ເບິ່ງເຫັນ/ຮັບໄດ້ໂດຍທຸກຄົນ
    // (ຄືເກົ່າ, ກໍລະນີ booking ເກົ່າ/ຍັງບໍ່ທັນຜ່ານ top-3 flow), ບໍ່ດັ່ງນັ້ນຕ້ອງເປັນ
    // ໜຶ່ງໃນ 3 ຄົນທີ່ຖືກເລືອກເທົ່ານັ້ນ.
    function isValidSentToTargeting() {
      return !('sentTo' in resource.data) ||
        resource.data.sentTo.size() == 0 ||
        request.auth.uid in resource.data.sentTo;
    }

    // 🔒 [AUDIT BE-1 / 2026-07-30] watchOpenJobs() (booking_repository.dart)
    // ບໍ່ເຄີຍ filter ດ້ວຍ sentTo ເລີຍ — Firestore ຕ້ອງການໃຫ້ list-query rule
    // ພິສູດໄດ້ຈາກ filter ຂອງ query ເອງເທົ່ານັ້ນ (ບໍ່ແມ່ນອ່ານ resource.data ຂອງແຕ່ລະ
    // doc ຫຼັງຈາກນັ້ນ) — ເມື່ອ isValidSentToTargeting() ອ້າງອີງ resource.data.sentTo
    // ໂດຍທີ່ query ບໍ່ໄດ້ constrain field ນີ້ເລີຍ, Firestore ປະຕິເສດ query ທັງໝົດ
    // (permission-denied), ບໍ່ແມ່ນສະເພາະ doc ທີ່ຜິດ — ໝາຍຄວາມວ່າ open job board
    // ວ່າງເປົ່າສະເໝີສຳລັບ provider ທຸກຄົນ. ແກ້ໂດຍແຍກເປັນ 2 query ທີ່ພິສູດໄດ້ແຍກກັນ
    // (watchOpenJobsPublic()/watchOpenJobsSentToMe() ໃນ booking_repository.dart):
    // query ໜຶ່ງ filter openToAll==true (ພິສູດໄດ້ຈາກ branch ທຳອິດ), ອີກອັນ filter
    // sentTo array-contains uid (ພິສູດໄດ້ຈາກ branch ທີສອງ). ໃຊ້ສະເພາະ READ —
    // ACCEPT/write ຍັງໃຊ້ isValidSentToTargeting() ເກົ່າ (ບໍ່ແມ່ນ list query,
    // ບໍ່ຕິດຂໍ້ຈຳກັດນີ້, ພຶດຕິກຳຖືກຕ້ອງແລ້ວ ບໍ່ຕ້ອງແກ້).
    function isOpenOrTargeted() {
      return (('openToAll' in resource.data) && resource.data.openToAll == true) ||
             (('sentTo' in resource.data) && request.auth.uid in resource.data.sentTo);
    }

    // 🔒 [AUDIT QA-1 / ME-3] ກ່ອນໜ້ານີ້ customer ສາມາດຂຽນ additionalCharges/
    // additionalChargesNote ເປັນຄ່າໃດກໍໄດ້ໂດຍກົງ (ບໍ່ຈຳກັດແຕ່ approve/reject) —
    // ໝາຍຄວາມວ່າ customer ສາມາດປອມ "ຄ່າໃຊ້ຈ່າຍເພີ່ມ" ຂອງຕົນເອງ ແລ້ວອະນຸມັດ
    // ໂດຍບໍ່ມີການຮ້ອງຂໍຈາກຊ່າງກ່ອນ. ຕອນນີ້ customer ຂຽນ 2 field ນີ້ໄດ້ສະເພາະ
    // ຄ່າ null ເທົ່ານັ້ນ (ກໍລະນີປະຕິເສດ, ເບິ່ງ respondToAdditionalCharges())
    // — approve (additionalChargesApproved) ຍັງເຮັດໄດ້ປົກກະຕິ, ບໍ່ຖືກຈຳກັດ.
    function isValidCustomerChargesResponse() {
      return (!('additionalCharges' in request.resource.data.diff(resource.data).affectedKeys()) ||
              request.resource.data.additionalCharges == null) &&
             (!('additionalChargesNote' in request.resource.data.diff(resource.data).affectedKeys()) ||
              request.resource.data.additionalChargesNote == null);
    }

    // 🔒 [AUDIT BE-4 / 2026-07-30] requestAdditionalCharges() (booking_repository.dart,
    // ຝັ່ງ provider) ຂຽນ additionalChargesApproved:false ພ້ອມກັບ additionalCharges/
    // additionalChargesNote ຕອນຮ້ອງຂໍຄ່າໃຊ້ຈ່າຍເພີ່ມ — ແຕ່ field ນີ້ບໍ່ເຄີຍຢູ່ໃນ
    // provider ຂອງ hasOnly() list ເລີຍ (ມີແຕ່ໃນ list ຂອງ customer), ແລະ ຕັ້ງແຕ່
    // booking ບໍ່ເຄີຍມີ field ນີ້ມາກ່ອນ, write ຄັ້ງທຳອິດຈຶ່ງນັບເປັນ affected key
    // ໃໝ່ສະເໝີ — ເຮັດໃຫ້ hasOnly() ບໍ່ຜ່ານ ແລະ write ທັງໝົດຖືກປະຕິເສດ
    // (permission-denied) ທຸກຄັ້ງ, ບໍ່ວ່າ provider ຄົນໃດ. ຕອນນີ້ອະນຸຍາດ provider
    // ຂຽນ field ນີ້ໄດ້ — ແຕ່ຈຳກັດຄ່າໃຫ້ເປັນ false ເທົ່ານັ້ນ (ຄືກັນກັບ
    // isValidCustomerChargesResponse() ຂ້າງເທິງທີ່ຈຳກັດ customer ໃຫ້ null
    // ເທົ່ານັ້ນ) — provider ບໍ່ສາມາດອະນຸມັດຄ່າໃຊ້ຈ່າຍເພີ່ມຂອງຕົນເອງໄດ້ເລີຍ, ມີແຕ່
    // customer branch (ບໍ່ຈຳກັດຄ່າ) ເທົ່ານັ້ນທີ່ອະນຸມັດ (true) ໄດ້.
    // 🔒 [AUDIT SEC-2 / 2026-07-30] ຂ້າງເທິງຈຳກັດແຕ່ additionalChargesApproved —
    // ຄ່າ additionalCharges/additionalChargesNote ຕົວເອງ (ຈຳນວນເງິນ) ບໍ່ເຄີຍຖືກ
    // ກວດ type/range ເລີຍຕອນ provider ຂຽນ, ຕ່າງຈາກ price ຂອງ booking ໃໝ່
    // (isValidNewBookingShape() ຂ້າງເທິງ ຈຳກັດ 0-50000000 ຢູ່ແລ້ວ) — provider
    // client ຄົນໃດກໍໄດ້ຈຶ່ງສາມາດຮ້ອງຂໍຄ່າໃຊ້ຈ່າຍເພີ່ມເປັນຄ່າລົບ ຫຼື ຈຳນວນບໍ່ມີເຫດຜົນ
    // ໄດ້. ໃຊ້ຂອບເຂດດຽວກັນກັບ price (0-50000000) ເມື່ອ field ນີ້ຖືກຂຽນ.
    // 🔒 [AUDIT BE-6 / 2026-08-02 — Low, fresh re-audit] previously not
    // conditioned on resource.data.status at all — unlike the sibling
    // admin-edit branch below (line ~607, !(status in [completed, cancelled,
    // rejected])) a provider could still write additionalCharges/Note fields
    // on a booking they own after it was cancelled/rejected. Not financially
    // exploitable (the only payout path additionally requires
    // status=='completed' — see grantAdditionalChargesWalletCredit() in
    // functions/index.js), just a data-hygiene gap; matches the sibling
    // pattern for consistency.
    function isValidProviderChargesRequest() {
      return !(resource.data.status in ['completed', 'cancelled', 'rejected']) &&
        (!('additionalChargesApproved' in request.resource.data.diff(resource.data).affectedKeys()) ||
        request.resource.data.additionalChargesApproved == false) &&
        (!('additionalCharges' in request.resource.data.diff(resource.data).affectedKeys()) ||
          request.resource.data.additionalCharges == null ||
          (request.resource.data.additionalCharges is number &&
           request.resource.data.additionalCharges > 0 &&
           request.resource.data.additionalCharges <= 50000000)) &&
        (!('additionalChargesNote' in request.resource.data.diff(resource.data).affectedKeys()) ||
          request.resource.data.additionalChargesNote == null ||
          request.resource.data.additionalChargesNote is string) &&
        // 🔒 [AUDIT BE-1 / 2026-08-02] round counter — requestAdditionalCharges()
        // (booking_repository.dart) ເພີ່ມຂຶ້ນ 1 ທຸກຄັ້ງທີ່ຮ້ອງຂໍໃໝ່, ໃຫ້ Cloud
        // Function ແຍກແຕ່ລະຮອບ (ບໍ່ໃຫ້ boolean ດຽວບລັອກຮອບທີ 2 ຂຶ້ນໄປ).
        (!('additionalChargesRound' in request.resource.data.diff(resource.data).affectedKeys()) ||
          request.resource.data.additionalChargesRound is number);
    }

    // 🔒 [AUDIT PROV-2 / 2026-07-30] ຊ່າງທີ່ຮັບງານໄປແລ້ວ (accepted/onTheWay/
    // arrived/inProgress) ບໍ່ເຄີຍມີທາງຍົກເລີກໄດ້ເລີຍຖ້າເຮັດຕໍ່ບໍ່ໄດ້ — booking
    // ຄ້າງຢູ່ນັ້ນຕະຫຼອດໄປ. isValidBookingStatusTransition() ອະນຸຍາດ →cancelled
    // ຈາກທຸກ state ທີ່ບໍ່ແມ່ນ terminal ຢູ່ແລ້ວ ໂດຍບໍ່ສົນວ່າໃຜຂຽນ — ພຽງແຕ່ບໍ່ເຄີຍມີ
    // method/UI ໃດເອີ້ນມັນ. ຕອນນີ້ອະນຸຍາດ provider (ເຈົ້າຂອງ booking) ຂຽນ status→
    // cancelled ໄດ້ (ຜ່ານ hasOnly() ຂ້າງລຸ່ມ) ພ້ອມກັບ cancelledBy — ຈຳກັດຄ່າ
    // cancelledBy ໃຫ້ເປັນ 'provider' ເທົ່ານັ້ນ (ຄືກັນກັບ isValidProviderChargesRequest()
    // ຂ້າງເທິງ) ບໍ່ໃຫ້ provider ຂຽນຄ່າອື່ນທຽມການຍົກເລີກຂອງຄົນອື່ນໄດ້.
    function isValidProviderCancelAttribution() {
      return !('cancelledBy' in request.resource.data.diff(resource.data).affectedKeys()) ||
        request.resource.data.cancelledBy == 'provider';
    }

    // ADMIN — ອ່ານໄດ້ທັງໝົດ, ຂຽນໄດ້ສະເພາະ collection ທີ່ບໍ່ມີ tier-gated
    // branch ຂອງຕົນເອງຢູ່ຂ້າງລຸ່ມ
    // 🔒 [AUDIT ADM-5 / 2026-07-30] Firestore ປະເມີນ match block ທຸກອັນທີ່ match
    // ກັບ path ດຽວກັນ ແລ້ວ OR ຜົນ allow ເຂົ້າກັນ (ບໍ່ມີ "ສະເພາະເຈາະຈົງກວ່າຊະນະ") —
    // ໝາຍຄວາມວ່າ blanket write ນີ້ຈະ grant write ໃສ່ bookings/{id} ໂດຍອັດຕະໂນມັດ
    // ໂດຍບໍ່ສົນໃຈວ່າ match /bookings/{bookingId} ຂ້າງລຸ່ມຈຳກັດແນວໃດ, ເຮັດໃຫ້
    // admin ຄົນໃດກໍໄດ້ (ບໍ່ວ່າ adminRole ໃດ) cancel/refund/edit booking ໃດກໍໄດ້
    // ໄດ້ໂດຍກົງ — ບໍ່ມີການບັງຄັບ 5-tier permission model ຂອງ lintho-admin
    // (ROLE_PERMISSIONS) ຢູ່ rule ຊັ້ນນີ້ເລີຍ. ຕອນນີ້ຍົກເວັ້ນ write ໃສ່ bookings/**
    // ອອກຈາກ blanket bypass ນີ້ໂດຍສະເພາະ — ບັງຄັບໃຫ້ໄປຜ່ານ branch ລະອຽດ
    // (isAdminRefund/isAdminCancel/isAdminEditNonCritical) ໃນ match /bookings
    // ແທນ.
    // 🔒 [AUDIT SEC-1/SEC-2/ADM-1 / 2026-08-02 — Critical, fresh re-audit]
    // ຄໍາເຫັນຂ້າງເທິງແກ້ສະເພາະ 'bookings' — collection ອື່ນທີ່ ROLE_PERMISSIONS
    // (lintho-admin src/constants/index.ts) ຈຳກັດເປັນ tier ສະເພາະ (ບໍ່ແມ່ນ admin
    // ໃດກໍໄດ້) ຄື users(role escalation)/wallets/withdrawalRequests/
    // topupRequests/providers/settings/coupons/transactions/reviews ຍັງຄົງຕົກ
    // ໃສ່ blanket bypass ນີ້ຢູ່ — ໝາຍຄວາມວ່າ admin tier ໃດກໍໄດ້ (ເຊັ່ນ
    // marketing_admin) ສາມາດ: (1) ຂຽນ users/{uid}.role='admin' +
    // adminRole='super_admin' ໃສ່ຕົນເອງ/ຄົນອື່ນໄດ້ໂດຍກົງ (ຂ້າມ
    // createAdminUser Cloud Function ແລະ _assertSuperAdmin() ທັງໝົດ — privilege
    // escalation ເຕັມຮູບແບບ), (2) ອະນຸມັດການຖອນ/ຕື່ມເງິນ ຫຼື ປັບຍອດ wallet
    // ຂອງໃຜກໍໄດ້ ທັງທີ່ ROLE_PERMISSIONS ຈຳກັດ withdrawals:approve/
    // topups:approve/wallet:adjust ໄວ້ສະເພາະ super_admin/finance_admin,
    // (3) ອະນຸມັດ/ປະຕິເສດ provider ຫຼືລຶບບັນຊີລູກຄ້າທັງທີ່ບໍ່ມີ providers:approve/
    // customers:delete. lintho-admin ຝັ່ງ UI (RequireRole/hasPermission) ອ່ານຈາກ
    // localStorage ເທົ່ານັ້ນ (ບໍ່ເຄີຍ re-verify ກັບ Firestore) ຈຶ່ງແກ້ໄຂ/ຂ້າມໄດ້ງ່າຍ
    // ຝັ່ງ client — rules ຊັ້ນນີ້ຕ້ອງເປັນຕົວບັງຄັບຈິງ. ຕອນນີ້ຍົກເວັ້ນ collection
    // ເຫຼົ່ານີ້ອອກຈາກ blanket write ນຳ, ບັງຄັບໃຫ້ໄປຜ່ານ getAdminRole()-gated
    // branch ຂອງແຕ່ລະ collection ເອງ (ເບິ່ງ match ຂອງແຕ່ລະອັນຂ້າງລຸ່ມ) — ຄືກັນກັບ
    // pattern ທີ່ໃຊ້ກັບ bookings ຢູ່ແລ້ວ. read ບໍ່ຖືກແຕະ (ບໍ່ແມ່ນຈຸດອ່ອນທີ່ກວດ
    // ພົບ — admin ທຸກ tier ຍັງອ່ານໄດ້ທັງໝົດຄືເກົ່າ). services/banners/
    // serviceAreas ຍັງບໍ່ຖືກຍົກເວັ້ນ (ບໍ່ມີ dedicated permission ໃນ
    // ROLE_PERMISSIONS ໃຫ້ອ້າງອີງ — admin ໃດກໍໄດ້ຂຽນໄດ້ຄືເກົ່າ, ບໍ່ແມ່ນຈຸດອ່ອນ
    // Critical ທີ່ກວດພົບຮອບນີ້).
    // 🔒 [AUDIT SEC-1 / 2026-08-06] ລາຍການຍົກເວັ້ນຂ້າງເທິງເຄີຍຖືກຂະຫຍາຍມາແລ້ວ
    // 2 ຄັ້ງ (ADM-5, ແລ້ວ SEC-1/SEC-2 ຮອບກ່ອນ) ແຕ່ຍັງບໍ່ຄົບ — 6 collection ນີ້ມີ
    // dedicated rule ຂອງຕົນເອງທີ່ຕັ້ງໃຈບັງຄັບ Cloud-Function-only ຫຼື field-level
    // restriction (rewardTransactions/rewardRedemptions/fcm_queue: `if false`
    // ສະເພາະບາງ operation, kyc/chats: field ຫຼື membership ຄວນຄົງທີ່,
    // referralCodes: update/delete `if false`) ແຕ່ຍັງບໍ່ໄດ້ຢູ່ໃນ exclusion
    // array — ໝາຍຄວາມວ່າ admin tier ໃດກໍໄດ້ (ລວມ marketing_admin/
    // support_admin ທີ່ບໍ່ຄວນແຕະ) ຍັງສາມາດຂຽນ/ລຶບກົງໄດ້ຜ່ານ blanket bypass ນີ້
    // ໂດຍກົງ, ຂ້າມ dedicated rule ຂອງແຕ່ລະ collection ໄປທັງໝົດ. ຕອນນີ້ເພີ່ມທັງ
    // 6 collection ນີ້ເຂົ້າ exclusion array — ບໍ່ມີ legitimate admin-write
    // use case ໃດອີງໃສ່ blanket rule ນີ້ຢູ່ແລ້ວສຳລັບ 6 ອັນນີ້.
    match /{document=**} {
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && !(request.path[3] in ['bookings', 'users', 'wallets', 'withdrawalRequests',
          'topupRequests', 'providers', 'settings', 'coupons', 'transactions',
          'rewardTransactions', 'rewardRedemptions', 'kyc', 'chats', 'fcm_queue',
          'referralCodes']);
    }

    match /users/{uid} {
      // 🔒 [AUDIT CRIT-2] ກ່ອນໜ້ານີ້ `allow read: if isAuth();` ໝາຍຄວາມວ່າ
      // user ໃດກໍໄດ້ທີ່ login ແລ້ວ (ລວມທັງບັນຊີສະໝັກໃໝ່) ສາມາດອ່ານ users/{uid}
      // ຂອງທຸກຄົນໄດ້ໂດຍກົງ (collection('users').get() ດຶງ PII ທັງໝົດ: ເບີໂທ,
      // lat/lng ບ້ານ, ຊື່, ຮູບ, ຄະແນນລາງວັນ). ຄໍາເຫັນເດີມອ້າງວ່າຕ້ອງເປີດກວ້າງ
      // ເພື່ອປ້ອງກັນ infinite loop ຈາກ getRole() — ແຕ່ getRole() ບໍ່ຖືກເອີ້ນໃນ
      // rule ນີ້ເລີຍ, ຈຶ່ງບໍ່ຈຳເປັນ. ຢືນຢັນແລ້ວວ່າ client ບໍ່ມີບ່ອນໃດອ່ານ
      // users/{uid} ຂອງຄົນອື່ນທີ່ບໍ່ແມ່ນຕົນເອງ (grep ທົ່ວ lib/) ຈຶ່ງຈຳກັດເປັນ
      // ເຈົ້າຂອງ ຫຼື admin ເທົ່ານັ້ນໂດຍບໍ່ກະທົບ feature ໃດເລີຍ.
      allow read: if isAuth() && (isOwner(uid) || isAdmin());
      // 🔒 [AUDIT C1] ກ່ອນໜ້ານີ້ create ບໍ່ໄດ້ຈຳກັດ field 'role' ເລີຍ — user ໃໝ່
      // ສາມາດ set({role: 'admin'}) ຕອນສ້າງ doc ຄັ້ງທຳອິດໄດ້ ແລ້ວຜ່ານ admin
      // bypass rule (line 58-60) ຄວບຄຸມຖານຂໍ້ມູນທັງໝົດ. ຕອນນີ້ບັງຄັບວ່າຖ້າມີ
      // field role ມາໃນ create, ຕ້ອງເປັນ 'customer' ຫຼື 'provider' ເທົ່ານັ້ນ —
      // 'admin' ຕ້ອງຖືກຕັ້ງຜ່ານ Cloud Function/Admin SDK ເທົ່ານັ້ນ.
      allow create: if isAuth() && isOwner(uid) &&
        (!('role' in request.resource.data) ||
         request.resource.data.role in ['customer', 'provider']);
      // ✅ rewardPoints ຕ້ອງຖືກປ່ຽນຜ່ານ Cloud Function (Admin SDK) ເທົ່ານັ້ນ
      // (onBookingStatusChange ຕອນ earn, onRewardRedemptionRequested ຕອນ redeem)
      // ບໍ່ດັ່ງນັ້ນລູກຄ້າຈະສາມາດແກ້ຍອດແຕ້ມຕົນເອງໂດຍກົງໄດ້
      // ✅ role ຫ້າມລູກຄ້າແກ້ໄຂເອງເດັດຂາດ — ບໍ່ດັ່ງນັ້ນຈະ self-promote ເປັນ
      // 'admin' ໄດ້ ແລະຜ່ານ admin bypass rule (line 58-60) ໄປແກ້ໄຂໄດ້ທຸກຢ່າງ
      // ໃນລະບົບ. ການປ່ຽນ role ຕ້ອງຜ່ານ Cloud Function/Admin SDK ເທົ່ານັ້ນ.
      // 🔒 [FOLLOWUP-3] ກ່ອນໜ້ານີ້ 'status' ບໍ່ຢູ່ໃນລາຍການປ້ອງກັນ — provider ທີ່
      // ຍັງບໍ່ຜ່ານ admin approve ສາມາດຂຽນ status='active' ໃສ່ຕົນເອງໂດຍກົງ ຂ້າມ
      // PendingApprovalScreen client-side ໄດ້. 'status' ຕ້ອງຖືກປ່ຽນຜ່ານ admin
      // ເທົ່ານັ້ນ (ຄືກັນກັບ providers/{uid}.kycStatus).
      allow update: if isAuth() && isOwner(uid) &&
        !('rewardPoints' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('role' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('status' in request.resource.data.diff(resource.data).affectedKeys());
      // 🔒 [AUDIT SEC-1/ADM-1 / 2026-08-02] Admin ຂຽນ status/suspendReason/
      // banReason (useSuspendCustomer/useBanCustomer/useDeleteCustomer,
      // lintho-admin) — ຕ້ອງເປັນ customers:write tier (super_admin,
      // operations_admin) ເທົ່ານັ້ນ. 'role' ແລະ 'adminRole' ຫ້າມຢູ່ໃນ branch
      // ນີ້ເດັດຂາດ (hasAny denylist ຂ້າງລຸ່ມ) — ການປ່ຽນ role ເປັນ 'admin'/ຍົກລະດັບ
      // adminRole ຕ້ອງຜ່ານ createAdminUser Cloud Function (_assertSuperAdmin())
      // ເທົ່ານັ້ນ, ບໍ່ດັ່ງນັ້ນ admin tier ໃດກໍໄດ້ຈະສາມາດຍົກລະດັບຕົນເອງເປັນ
      // super_admin ໄດ້ໂດຍກົງຜ່ານ path ນີ້ (ນີ້ຄືຊ່ອງໂຫວ່ຕົ້ນຕໍທີ່ພົບ).
      allow update: if getAdminRole() in ['super_admin', 'operations_admin'] &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'adminRole', 'rewardPoints']);
      // customers:delete → super_admin ເທົ່ານັ້ນ (ROLE_PERMISSIONS)
      allow delete: if getAdminRole() == 'super_admin';

      match /addresses/{addrId} {
        allow read, create, delete: if isAuth() && isOwner(uid);
        allow update: if false;
      }
    }

    // App-wide config (settings/general = maintenance mode, support email, ...;
    // settings/rewards = earn/redeem rates). Customer/Provider apps ຕ້ອງອ່ານໄດ້
    // ເພື່ອກວດ maintenanceMode ແບບ live — ຂຽນໄດ້ສະເພາະ admin (explicit ຢູ່ນີ້
    // ນອກເໜືອຈາກ blanket bypass rule ຂ້າງເທິງ, ເພື່ອໃຫ້ intent ຊັດເຈນ).
    // 🔒 [AUDIT SEC-1/ADM-1/ADM-5 / 2026-08-02] isAdmin() ບໍ່ຮູ້ຈັກ tier — admin
    // ໃດກໍໄດ້ (ລວມທັງ support_admin/marketing_admin ທີ່ບໍ່ມີ settings:write ໃນ
    // ROLE_PERMISSIONS) ຂຽນ settings ໄດ້ໝົດ. settings/rewards ຕ້ອງການ
    // rewards:write (super_admin, marketing_admin — ໜ້າ Rewards ຂອງ
    // lintho-admin) — settings/{general,payment_config,legal} ອື່ນໆຕ້ອງການ
    // settings:write (super_admin ເທົ່ານັ້ນ, ບໍ່ມີ tier ອື່ນຖືກມອບໝາຍ permission
    // ນີ້ໃນ ROLE_PERMISSIONS).
    match /settings/{docId} {
      allow read: if isAuth();
      allow write: if docId == 'rewards'
        ? getAdminRole() in ['super_admin', 'marketing_admin']
        : getAdminRole() == 'super_admin';
    }

    // 🔒 [AUDIT M-3 / 2026-07-27] settings/legal (ເນື້ອຫາ Terms & Privacy,
    // ແກ້ໄຂໄດ້ໂດຍ admin ຜ່ານ lintho-admin) ຖືກກອງໄວ້ຫຼັງ isAuth() ຂ້າງເທິງ, ແຕ່
    // register_otp.dart ສະແດງ Terms/Privacy sheet ນີ້ຢູ່ໜ້າເລືອກປະເພດບັນຊີ —
    // ກ່ອນ sign-in ໃດໆ (customer_register_flow.dart/technician_register_screen.dart
    // ບໍ່ signInAnonymously). ການອ່ານຈຶ່ງ permission-denied ງຽບໆ ແລະ sheet ຕົກ
    // ໄປໃຊ້ຂໍ້ຄວາມ hardcoded ເກົ່າສະເໝີ ສຳລັບຜູ້ໃຊ້ໃໝ່ທຸກຄົນ — ບັນຫາເກົ່າທີ່
    // legalContentProvider ຖືກສ້າງມາແກ້ ພຽງແຕ່ຍ້າຍໄປຢູ່ຈຸດດຽວທີ່ຮຽກກ່ອນ auth.
    // ເນື້ອຫານີ້ບໍ່ແມ່ນຂໍ້ມູນລັບ (Terms & Privacy ສາທາລະນະຢູ່ແລ້ວ) — ອະນຸຍາດອ່ານ
    // ໂດຍບໍ່ຕ້ອງ login ສະເພາະ doc ນີ້ອັນດຽວ, ຄົງ isAdmin()-only write ໄວ້ຄືເກົ່າ.
    match /settings/legal {
      allow read: if true;
    }

    // settings/support (ເບີໂທ/WhatsApp/Email/ເວລາເປີດບໍລິການ ຂອງທີມ Support —
    // ອ່ານໄດ້ໂດຍ settings/{docId} ຂ້າງເທິງແລ້ວ, ບໍ່ຕ້ອງມີ match ແຍກ) ແລະ
    // faqs (top-level collection, ບໍ່ຢູ່ໃຕ້ settings/{docId} ຈຶ່ງຕ້ອງມີ match
    // ຂອງຕົນເອງ — ບໍ່ດັ່ງນັ້ນຈະຕົກໄປໂດນ blanket admin-only bypass ຂ້າງເທິງ).
    // ອ່ານໄດ້ໂດຍ user ທີ່ login ແລ້ວທຸກຄົນ (ບໍ່ແມ່ນຂໍ້ມູນລັບ), ຂຽນໄດ້ສະເພາະ admin
    // ຜ່ານ lintho-admin.
    match /faqs/{faqId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /bookings/{bookingId} {
      // resource == null ກໍລະນີ doc ຍັງບໍ່ມີ (ໃຊ້ໂດຍ get() ກວດ idempotent
      // ກ່ອນ create ດ້ວຍ clientRequestId) — ບໍ່ມີ data ໃຫ້ leak ຢູ່ແລ້ວ ຈຶ່ງອະນຸຍາດໄດ້
      allow read: if isAuth() && (
        resource == null ||
        resource.data.customerId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        (isVerifiedProvider() && resource.data.status == 'pending' &&
          isOpenOrTargeted())
      );

      // ປັບໃຫ້ Customer ທຸກຄົນທີ່ Login ສາມາດສ້າງ Booking ໄດ້ງ່າຍຂຶ້ນ
      // ກວດເພີ່ມ: lat/lng ຕ້ອງເປັນ number ແລະ ຢູ່ໃນຂອບເຂດທີ່ຖືກຕ້ອງ
      // 🔒 [AUDIT H2] ປ່ຽນ || ເປັນ && — ເມື່ອກ່ອນ isCustomer()==true ຢ່າງດຽວກໍ
      // ພຽງພໍໃຫ້ຜ່ານ, ໝາຍຄວາມວ່າ customer ຄົນໜຶ່ງສາມາດ set customerId ເປັນ uid
      // ຂອງຄົນອື່ນໄດ້ (ປອມ booking ໃສ່ບັນຊີຄົນອື່ນ). ຕອນນີ້ບັງຄັບວ່າ customerId
      // ຕ້ອງເປັນ auth.uid ຕົນເອງ "ແລະ" ຕ້ອງເປັນ role customer ນຳ.
      allow create: if isAuth() &&
        request.resource.data.customerId == request.auth.uid && isCustomer() &&
        isValidLatLng() && isValidNewBookingShape();

      // ປັບປຸງໃຫ້ Customer ສາມາດອັບເດດຂໍ້ມູນການຊຳລະເງິນ ແລະ ສະຖານະໄດ້
      // lat/lng ບໍ່ຢູ່ໃນ list ນີ້ — ບໍ່ໃຫ້ແກ້ໄຂຕຳແໜ່ງພາຍຫຼັງສ້າງ booking ແລ້ວ
      // 🔒 [AUDIT C2] ກ່ອນໜ້ານີ້ຝັ່ງ provider ກວດແຕ່ isProvider() ໂດຍບໍ່ກວດວ່າ
      // ເປັນ provider ຂອງ booking ນີ້ແທ້ — provider ຄົນອື່ນສາມາດແຍ່ງງານ (ຂຽນທັບ
      // providerId), ປອມ status='completed', ແລະ self-approve
      // additionalChargesApproved ຂອງຕົນເອງໄດ້. ຕອນນີ້ບັງຄັບວ່າ:
      //  1) ຕ້ອງເປັນເຈົ້າຂອງ booking ນີ້ຢູ່ແລ້ວ (resource.data.providerId == uid)
      //     ຫຼື 2) ບໍ່ມີເຈົ້າຂອງ ແລະ status='pending' (ກຳລັງຮັບງານໃໝ່) ເທົ່ານັ້ນ
      // ແລະ additionalChargesApproved ຖືກຍົກອອກຈາກ list ນີ້ — ມີແຕ່ customer
      // ເທົ່ານັ້ນທີ່ອະນຸມັດຄ່າໃຊ້ຈ່າຍເພີ່ມໄດ້ (ຢູ່ໃນ list ຂອງ customer ຂ້າງເທິງ).
      allow update: if isAuth() && isValidCompletionPayment() &&
        isValidBookingStatusTransition() && isValidPaymentTransition() && (
        // 🔒 [FOLLOWUP-K] ເພີ່ມ 'customerConfirmedPayment' — ລູກຄ້າຢືນຢັນວ່າໄດ້
        // ໂອນເງິນຜ່ານ BCEL ແລ້ວ, ໃຊ້ເປັນ counter-signature ກ່ອນຊ່າງຈະຢືນຢັນຮັບເງິນ
        // ຝ່າຍດຽວໄດ້ (ເບິ່ງ confirmPaymentReceived() booking_repository.dart).
        // 🔒 [AUDIT SEC-1 / 2026-07-30] isValidBookingStatusTransition() ກວດແຕ່
        // ຄ່າ status transition (ຖືກຕ້ອງຕາມລຳດັບ), ບໍ່ເຄີຍກວດວ່າໃຜເປັນຄົນຂຽນ —
        // customer branch ນີ້ອະນຸຍາດ 'status' ຢູ່ໃນ hasOnly() ໂດຍບໍ່ຈຳກັດຄ່າປາຍທາງ
        // ເລີຍ, ໝາຍຄວາມວ່າ customer ສາມາດຂຽນ status ຜ່ານທຸກຂັ້ນຕອນໄປຈົນຮອດ
        // 'completed' ໂດຍກົງ (ຂ້າມຊ່າງທັງໝົດ), ກະຕຸ້ນ onBookingStatusChange ໃຫ້
        // ຝາກເງິນເຂົ້າ wallet ຊ່າງ, ໃຫ້ reward points ຕົນເອງ, ແລະ post review ປອມ
        // ໄດ້ — ທັງໆທີ່ CustomerBookingRepository (booking_repository.dart) ບໍ່ເຄີຍ
        // ຂຽນ status ນອກຈາກ 'cancelled' ຢູ່ແລ້ວ (verified: cancelBooking() ເປັນ
        // status write ດຽວໃນ class ນີ້). ຕອນນີ້ບັງຄັບວ່າ ຖ້າ customer ຂຽນ status,
        // ຄ່າຕ້ອງເປັນ 'cancelled' ເທົ່ານັ້ນ — forward transition ທັງໝົດຕ້ອງມາຈາກ
        // provider branch ຂ້າງລຸ່ມເທົ່ານັ້ນ.
        (resource.data.customerId == request.auth.uid &&
          isValidCustomerChargesResponse() &&
          (!('status' in request.resource.data.diff(resource.data).affectedKeys()) ||
            request.resource.data.status == 'cancelled') &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'reviewed', 'additionalChargesApproved', 'additionalCharges',
              'additionalChargesNote', 'paymentMethod', 'paymentStatus', 'slipUrl', 'sentTo',
              'openToAll', 'updatedAt', 'cancelReason', 'cancelledBy', 'cancelFeeAmount',
              'matchConfirmed', 'customerConfirmedPayment'])) ||
        // 🔒 [AUDIT H3] ກ່ອນໜ້ານີ້ຮັບງານໃໝ່ (claim: status=='pending' &&
        // ຂຽນ providerId ເປັນຕົນເອງ) ພຽງແຕ່ກວດ isProvider() (role=='provider'
        // ເປົ່າໆ, ຈິງ/ບໍ່ຈິງກໍໄດ້ຖ້າຍັງບໍ່ຜ່ານ KYC) — ບໍ່ຄືກັນກັບ read rule ຂ້າງເທິງ
        // (isVerifiedProvider()) ທີ່ຖືກແກ້ໄປແລ້ວ.
        // 🔒 [follow-up] ຄໍາເຫັນເດີມທີ່ນີ້ອ້າງວ່າ "ສາຂາ providerId==uid ບໍ່ຈຳເປັນ
        // ຕ້ອງກວດຄືນເພາະ isVerifiedProvider() ຕ້ອງຜ່ານແລ້ວຄັ້ງທຳອິດຕອນຮັບ" ຜິດ —
        // ກໍລະນີລູກຄ້າຈອງຊ່າງສະເພາະຄົນໂດຍກົງ (booking_form_screen.dart ຮັບ
        // providerId ຕອນສ້າງ booking, ບໍ່ແມ່ນຕອນຊ່າງ accept), providerId ຖືກ
        // ລູກຄ້າ (ບໍ່ແມ່ນຊ່າງ) ຕັ້ງໄວ້ຕັ້ງແຕ່ຕົ້ນ — ຊ່າງທີ່ບໍ່ເຄີຍຜ່ານ KYC ຈຶ່ງ
        // ຍັງ "providerId == ຕົນເອງ" ໄດ້ໂດຍບໍ່ເຄີຍຜ່ານ isVerifiedProvider() ເລີຍ.
        // ຕອນນີ້ບັງຄັບ isVerifiedProvider() ໃນທັງສອງສາຂາ.
        // 🔒 [AUDIT H-2 / 2026-07-27] ເພີ່ມ isValidSentToTargeting() ໃສ່ສາຂາ
        // "ຮັບງານໃໝ່" (claim: status=='pending' && ຂຽນ providerId ເປັນຕົນເອງ) —
        // ຮັບໄດ້ສະເພາະຖ້າ booking ນີ້ບໍ່ໄດ້ຖືກຈຳກັດ sentTo ຫຼື ຕົນເອງຢູ່ໃນ sentTo.
        // ສາຂາ "ຢູ່ແລ້ວ" (resource.data.providerId==self) ບໍ່ຕ້ອງກວດຄືນ ເພາະ
        // ໝາຍຄວາມວ່າຕົນເອງໄດ້ຮັບງານນີ້ໄປແລ້ວຢ່າງຖືກຕ້ອງ (ຜ່ານການກວດນີ້ມາແລ້ວຄັ້ງ
        // ທຳອິດ). ເພີ່ມ providerPhone/providerRating/providerJobs/providerPhoto
        // ໃສ່ list ອະນຸຍາດ [H-1] — acceptBooking() (booking_repository.dart)
        // ຕອນນີ້ຂຽນ field ເຫຼົ່ານີ້ຈາກ providers/{uid} ຂອງຕົນເອງພາຍໃນ transaction
        // ດຽວກັນກັບ status→accepted, ໃຫ້ໜ້າ Match/Tracking/Detail/Review ຂອງ
        // ລູກຄ້າສະແດງຊື່/ເບີ/ຄະແນນ/ຮູບຊ່າງໄດ້ຈິງ (ກ່ອນໜ້ານີ້ບໍ່ເຄີຍຖືກຂຽນ, ໜ້າຈໍ
        // ເຫຼົ່ານີ້ຈຶ່ງສະແດງຄ່າວ່າງ).
        (isProvider() && isVerifiedProvider() &&
          (resource.data.providerId == request.auth.uid ||
            (resource.data.status == 'pending' &&
             request.resource.data.providerId == request.auth.uid &&
             isValidSentToTargeting())) &&
          isValidProviderChargesRequest() &&
          isValidProviderCancelAttribution() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'providerId', 'providerName', 'providerPhone',
              'providerRating', 'providerJobs', 'providerPhoto', 'acceptedAt',
              'completedAt', 'cancelReason', 'cancelledBy', 'beforePhotoUrl', 'afterPhotoUrl',
              'additionalCharges', 'additionalChargesNote', 'additionalChargesApproved',
              'additionalChargesRound', 'paymentStatus', 'updatedAt'])) ||
        // 🔒 [AUDIT H7] "ປະຕິເສດ" ວຽກທີ່ຍັງບໍ່ມີ providerId (ຢູ່ໃນ open job
        // board — ບໍ່ໄດ້ຖືກມອບໝາຍໃຫ້ໃຜສະເພາະ) ບໍ່ຄວນປ່ຽນ status ເປັນ terminal
        // 'rejected' ເລີຍ — ນັ້ນຈະເຮັດໃຫ້ provider ອື່ນທີ່ຍັງບໍ່ທັນເຫັນ/ຕັດສິນໃຈ
        // ບໍ່ສາມາດຮັບງານໄດ້ອີກຕໍ່ໄປ ທັງໆທີ່ຍັງບໍ່ໝົດເວລາຄົ້ນຫາ. ອະນຸຍາດໃຫ້ provider
        // ທີ່ຍັງບໍ່ຖືກມອບໝາຍ (ບໍ່ແມ່ນເຈົ້າຂອງ) ຂຽນສະເພາະ rejectedBy/updatedAt
        // (ບັນທຶກວ່າຕົນເອງປະຕິເສດ) ໂດຍບໍ່ແຕະ status ເລີຍ — booking ຄົງເປັນ
        // 'pending' ໃຫ້ provider ອື່ນຍັງເຫັນ/ຮັບໄດ້.
        (isVerifiedProvider() &&
          resource.data.status == 'pending' &&
          resource.data.providerId != request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rejectedBy', 'updatedAt'])) ||
        // 🔒 [AUDIT ADM-5/ADM-1 / 2026-07-30] ຕົ້ນທາງ admin write ໃສ່ bookings
        // ຕອນນີ້ຄື 3 branch ລະອຽດຂ້າງລຸ່ມ (ບໍ່ແມ່ນ blanket admin bypass ອີກຕໍ່ໄປ —
        // ເບິ່ງ match /{document=**} ຂ້າງເທິງ) — ແຕ່ລະ branch ກົງກັບ
        // ROLE_PERMISSIONS ໃນ lintho-admin src/constants/index.ts ເປັກໆ.
        //
        // ADM-1: ຄືນເງິນ (bookings:refund → super_admin, finance_admin) —
        // ຕັ້ງໃຈບໍ່ແຕະ status ເລີຍ (status ຄົງເປັນ 'completed', parse ໄດ້ປົກກະຕິ
        // ໃນ Customer/Provider app ແລະ ຍັງເຫັນຢູ່ໃນ provider job history —
        // ກ່ອນໜ້ານີ້ useRefundBooking ຂຽນ status:'refunded', ບໍ່ແມ່ນສະມາຊິກຂອງ
        // JobStatus enum, ເຮັດໃຫ້ Booking.fromFirestore()._parseStatus() fallback
        // ເປັນ 'pending' ໃສ່ລູກຄ້າ ແລະ ຫາຍໄປຈາກ provider job history whereIn
        // filter). ຄືນເງິນໄດ້ສະເພາະ booking ທີ່ status=='completed' ແລະ
        // paymentStatus ຍັງເປັນ 'paid' ຢູ່ (ບໍ່ຄືນຊ້ຳ — ຄັ້ງທຳອິດປ່ຽນ paymentStatus
        // ອອກຈາກ 'paid' ແລ້ວ ຄັ້ງທີສອງຈະບໍ່ຜ່ານ precondition ນີ້ອີກ).
        (getAdminRole() in ['super_admin', 'finance_admin'] &&
          resource.data.status == 'completed' &&
          resource.data.paymentStatus == 'paid' &&
          request.resource.data.paymentStatus == 'refunded' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['paymentStatus', 'refundAmount', 'refundReason',
              'refundedAt', 'refundedBy', 'updatedAt'])) ||
        // ADM-5: ຍົກເລີກ (bookings:cancel → super_admin, operations_admin) —
        // isValidBookingStatusTransition() (ຂ້າງເທິງ, ບັງຄັບຢູ່ແລ້ວທຸກ branch)
        // ຈຳກັດວ່າຮັບໄດ້ສະເພາະຈາກ state ທີ່ບໍ່ແມ່ນ terminal ຢູ່ແລ້ວ.
        (getAdminRole() in ['super_admin', 'operations_admin'] &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'cancelReason', 'cancelledBy', 'updatedAt'])) ||
        // ADM-5: ແກ້ໄຂຂໍ້ມູນ non-critical (bookings:write → super_admin,
        // operations_admin, support_admin) — ຈຳກັດສະເພາະ field ທີ່
        // EditBookingModal (lintho-admin) ຂຽນແທ້ (serviceType/address/notes/
        // scheduledAt), ບໍ່ແຕະ status/price/providerId/ຄ່າການເງິນໃດໆ. ຈຳກັດແຕ່
        // booking ທີ່ຍັງບໍ່ຮອດ terminal state — ບໍ່ມີເຫດຜົນທີ່ຈະແກ້ໄຂ booking
        // ທີ່ completed/cancelled/rejected ໄປແລ້ວ (ຮັກສາ historical record).
        (getAdminRole() in ['super_admin', 'operations_admin', 'support_admin'] &&
          !(resource.data.status in ['completed', 'cancelled', 'rejected']) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['serviceType', 'address', 'notes', 'scheduledAt', 'updatedAt']))
      );
      allow delete: if false;
    }

    match /providers/{providerId} {
      allow read: if isAuth();

      // ສ້າງ doc ໃໝ່: ບໍ່ບັງຄັບ lat/lng (ບາງ flow ສ້າງ profile ກ່ອນເລີ່ມ Online)
      // ແຕ່ຖ້າມີ lat/lng ມາ ຕ້ອງຖືກຕ້ອງ
      // 🔒 [AUDIT H3/H6 follow-up] ກ່ອນໜ້ານີ້ create ບໍ່ຈຳກັດ kycStatus/rating/
      // totalJobs/completionRate ເລີຍ (ມີແຕ່ update ຖືກລັອກ) — ບັນຊີ provider
      // ໃໝ່ສາມາດ set({kycStatus:'verified', rating:5, totalJobs:500,
      // completionRate:100}) ຕອນສ້າງ doc ຄັ້ງທຳອິດໄດ້ໂດຍກົງ, ຂ້າມ isVerifiedProvider()
      // (H3) ແລະ ປອມຄະແນນ (H6/H9) ຜ່ານ path ນີ້ແທນ. ຕອນນີ້ບັງຄັບວ່າ field
      // ເຫຼົ່ານີ້ ຖ້າມີມາ ຕ້ອງເປັນຄ່າເລີ່ມຕົ້ນທີ່ຖືກຕ້ອງເທົ່ານັ້ນ (ກົງກັບຄ່າທີ່
      // technician_register_screen.dart / booking_repository.dart ຂຽນຈິງ).
      // 🔒 [AUDIT KYC-1] kycDocUrl/kycIdUrl/kycSelfieUrl ຫ້າມຢູ່ໃນ doc ນີ້ເລີຍ —
      // providers/{uid} ອ່ານໄດ້ໂດຍ user login ໃດກໍໄດ້ (line ຂ້າງເທິງ), ຖ້າ URL
      // ຮູບບັດປະຈຳຕົວ/selfie ຢູ່ນີ້ຈະຮົ່ວອອກໄປໃຫ້ທຸກຄົນອ່ານໄດ້. ຮູບ KYC ຕ້ອງເກັບ
      // ໄວ້ໃນ kyc/{uid} ເທົ່ານັ້ນ (ອ່ານໄດ້ສະເພາະເຈົ້າຂອງ/admin).
      // 🔒 [AUDIT SEC-3 / 2026-08-02] 'phone' ຫ້າມຢູ່ doc ນີ້ນຳ pattern ດຽວກັນ —
      // ເບີໂທຢູ່ users/{uid} ເທົ່ານັ້ນ (owner+admin ອ່ານໄດ້), acceptBooking()
      // ອ່ານຈາກນັ້ນແທນ (booking_repository.dart).
      allow create: if isAuth() && isOwner(providerId) && isValidLatLngIfChanged() &&
        !('kycDocUrl' in request.resource.data) &&
        !('kycIdUrl' in request.resource.data) &&
        !('kycSelfieUrl' in request.resource.data) &&
        !('phone' in request.resource.data) &&
        (!('kycStatus' in request.resource.data) ||
          request.resource.data.kycStatus in ['none', 'pending']) &&
        (!('isVerified' in request.resource.data) ||
          request.resource.data.isVerified == false) &&
        (!('rating' in request.resource.data) || request.resource.data.rating == 0) &&
        (!('totalJobs' in request.resource.data) || request.resource.data.totalJobs == 0) &&
        (!('completionRate' in request.resource.data) ||
          request.resource.data.completionRate == 0);

      // ອັບເດດ: ເຈົ້າຂອງແກ້ໄຂ profile/location ຂອງຕົນເອງໄດ້
      // ກວດ lat/lng ໃຫ້ຖືກຕ້ອງສະເພາະເວລາມີການແກ້ໄຂ field ນັ້ນ
      // ✅ isVerified/rejectReason/suspendReason ຫ້າມ owner ແກ້ໄຂເອງເດັດຂາດ —
      // field ເຫຼົ່ານີ້ຕ້ອງຖືກປ່ຽນຜ່ານ admin (LinTho Admin Panel) ຜ່ານ admin
      // bypass rule (line 58-60) ເທົ່ານັ້ນ ບໍ່ດັ່ງນັ້ນ provider ຈະສາມາດ
      // self-approve ຕົນເອງເປັນ verified ໄດ້
      // 🔒 [AUDIT H6] ກ່ອນໜ້ານີ້ customer ຄົນໃດກໍໄດ້ສາມາດຂຽນ rating/totalJobs/
      // completionRate ຂອງ provider ຄົນໃດກໍໄດ້ໂດຍກົງ (ບໍ່ຕ້ອງມີ review/booking
      // ຈິງເລີຍ) — ຕອນນີ້ 3 field ນີ້ຄິດໄລ່ຢູ່ Cloud Function ເທົ່ານັ້ນ
      // (onReviewCreated/onBookingStatusChange, functions/index.js), ອອກຈາກ
      // list ທີ່ client ຂຽນໄດ້ຫມົດ.
      // 🔒 [FIX KYC-2 / Batch G] kycStatus used to be in the blanket-blocked
      // list above, which also permanently blocked the one legitimate
      // self-service transition: a rejected provider resubmitting KYC
      // (uploadKyc() writes photos/kyc/{uid} fine, then this rule denied the
      // providers/{uid}.kycStatus='pending' write, leaving every rejected
      // provider stuck forever with no way back in). Now kycStatus is
      // allowed in the diff ONLY for the exact rejected|none -> pending
      // self-transition; every other kycStatus write (any path to
      // 'verified', writing 'rejected'/'suspended', or moving from
      // 'pending'/'verified' to anything) still falls through to deny here —
      // those states can only ever be set by the admin-tier branch below.
      allow update: if isAuth() &&
        isOwner(providerId) && isValidLatLngIfChanged() &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['isVerified', 'rejectReason', 'suspendReason',
            'rating', 'totalJobs', 'completionRate',
            'kycDocUrl', 'kycIdUrl', 'kycSelfieUrl', 'phone']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['kycStatus']) ||
          (resource.data.get('kycStatus', 'none') in ['none', 'rejected'] &&
            request.resource.data.kycStatus == 'pending'));

      // 🔒 [AUDIT SEC-1/ADM-1 / 2026-08-02] Admin approve/reject/suspend
      // (useApproveProvider/useRejectProvider/useSuspendProvider — writes
      // kycStatus/rejectReason/suspendReason/isOnline) ແລະ generic edit
      // (useUpdateProvider) — ຕ້ອງເປັນ providers:write/providers:approve tier
      // (super_admin, operations_admin) ເທົ່ານັ້ນ. rating/totalJobs/
      // completionRate ຍັງຄົງຄິດໄລ່ໄດ້ສະເພາະ Cloud Function ເທົ່ານັ້ນ (ບໍ່ໃຫ້
      // admin ຂຽນທັບໂດຍກົງ), ແລະ kycDocUrl/kycIdUrl/kycSelfieUrl ຍັງຄົງຫ້າມຢູ່
      // doc ນີ້ເລີຍ (ຄືກັນກັບ owner branch — KYC-1).
      allow update: if getAdminRole() in ['super_admin', 'operations_admin'] &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['rating', 'totalJobs', 'completionRate',
            'kycDocUrl', 'kycIdUrl', 'kycSelfieUrl', 'phone']);

      allow delete: if false;

      // 🔒 [AUDIT H6/H9] ກ່ອນໜ້ານີ້ `allow create: if isAuth();` ບໍ່ມີການກວດ
      // ຫຍັງເລີຍ — customerId ບໍ່ຕ້ອງກົງກັບ auth.uid, rating ຂຽນຄ່າໃດກໍໄດ້
      // (ລວມທັງຕິດລົບ/ເກີນ 5), ແລະ ບໍ່ຕ້ອງມີ booking ຈິງຢູ່ເບື້ອງຫຼັງເລີຍ — customer
      // ຄົນໃດກໍໄດ້ສາມາດປອມ review ໃຫ້/ຕິ provider ຄົນໃດກໍໄດ້. ຕອນນີ້ບັງຄັບວ່າ
      // ຕ້ອງ (1) customerId ເປັນຕົນເອງ, (2) rating ຢູ່ໃນຂອບເຂດ 1-5, (3) booking
      // ທີ່ອ້າງອີງມີຈິງ, ເປັນຂອງລູກຄ້າ+ຊ່າງຄູ່ນີ້ແທ້, status=='completed' ແລ້ວ,
      // ແລະ ຍັງບໍ່ເຄີຍຖືກ review (reviewed != true) — ປ້ອງກັນທັງ spoofed review
      // ແລະ double-review. reviewed:true flag ຖືກຕັ້ງໂດຍ Cloud Function
      // (onReviewCreated) ຫຼັງຈາກນີ້, ບໍ່ແມ່ນ client ຕັ້ງເອງ.
      match /reviews/{reviewId} {
        allow read: if isAuth();
        allow create: if isAuth() &&
          request.resource.data.customerId == request.auth.uid &&
          request.resource.data.rating is number &&
          request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
          exists(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)) &&
          get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.customerId == request.auth.uid &&
          get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.providerId == providerId &&
          get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == 'completed' &&
          get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.reviewed != true;
        // ✅ [Bonus fix — found while working on H6/H9] ProfileRepository.
        // replyToReview() (lib/booking_repository.dart) ຂຽນ providerReply ໃສ່
        // path ນີ້ (providers/{uid}/reviews/{id}) ແຕ່ rule ນີ້ເຄີຍເປັນ
        // `if false` ໝົດ — ໝາຍຄວາມວ່າ "ຕອບກັບຣີວິວ" feature ຖືກ deny ຕະຫຼອດ.
        // ອະນຸຍາດສະເພາະຊ່າງເຈົ້າຂອງ review ນັ້ນແກ້ໄຂ field providerReply ດຽວ.
        allow update: if isProvider() &&
          resource.data.providerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['providerReply']);

        // 🔒 [AUDIT SEC-1/ADM-1 / 2026-08-02] Admin hide/restore/delete
        // (useHideReview/useRestoreReview/useDeleteReview, lintho-admin) —
        // ຕ້ອງເປັນ reviews:delete tier (super_admin, operations_admin,
        // support_admin) ເທົ່ານັ້ນ. ກ່ອນໜ້ານີ້ອາໄສ blanket admin bypass ຢ່າງດຽວ
        // (admin ໃດກໍໄດ້ເຮັດໄດ້) — ຕອນນີ້ path ນີ້ຢູ່ໃຕ້ providers/{id} ຈຶ່ງຖືກ
        // ຍົກເວັ້ນອອກຈາກ blanket write ດ້ວຍ, ຕ້ອງມີ branch ຂອງຕົນເອງ.
        allow update: if getAdminRole() in ['super_admin', 'operations_admin', 'support_admin'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'hideReason']);
        allow delete: if getAdminRole() in ['super_admin', 'operations_admin', 'support_admin'];
      }
    }

    match /wallets/{uid} {
      allow read: if isAuth() && isOwner(uid);

      // 🔒 [AUDIT C3] ກ່ອນໜ້ານີ້ "allow read, write: if isOwner(uid)" ໝາຍຄວາມວ່າ
      // ເຈົ້າຂອງ wallet ສາມາດແກ້ balance/totalEarnings ຕົນເອງໂດຍກົງໄດ້ຜ່ານ
      // client SDK ໂດຍບໍ່ຜ່ານ onBookingStatusChange ເລີຍ. ຕອນນີ້ແຍກ create/update:
      // - create: ອະນຸຍາດຄັ້ງທຳອິດ (ຕອນສະໝັກ provider) ແຕ່ຕ້ອງເລີ່ມຕົ້ນຍອດ 0
      //   ເທົ່ານັ້ນ (ຫ້າມສ້າງພ້ອມຍອດເງິນທີ່ບໍ່ແມ່ນ 0)
      // - update: ຂຽນໄດ້ສະເພາະຂໍ້ມູນທະນາຄານ (bankName/bankAccount/bankHolder)
      //   ເທົ່ານັ້ນ — balance/totalEarnings ຕ້ອງຜ່ານ Cloud Function/Admin SDK
      allow create: if isAuth() && isOwner(uid) &&
        (!('balance' in request.resource.data) || request.resource.data.balance == 0) &&
        (!('totalEarnings' in request.resource.data) || request.resource.data.totalEarnings == 0);
      allow update: if isAuth() && isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['bankName', 'bankAccount', 'bankHolder', 'updatedAt']);

      // 🔒 [AUDIT SEC-1/SEC-2/ADM-1 / 2026-08-02] Admin top-up approval
      // (useApproveTopup) ແລະ manual wallet adjustment (useAdjustWalletBalance)
      // ຂຽນ balance/totalEarnings ໂດຍກົງ — ROLE_PERMISSIONS ຈຳກັດ wallet:adjust/
      // topups:approve ໄວ້ສະເພາະ super_admin/finance_admin, ແຕ່ blanket bypass
      // ເກົ່າອະນຸຍາດ admin tier ໃດກໍໄດ້. ຈຳກັດ field ໃຫ້ຂຽນໄດ້ສະເພາະ
      // balance/totalEarnings (ບໍ່ແຕະ bankName/bankAccount/bankHolder ຂອງ
      // ຊ່າງ, ຄືກັນກັບ owner branch ຂ້າງເທິງທີ່ຈຳກັດກົງກັນຂ້າມ).
      allow update: if getAdminRole() in ['super_admin', 'finance_admin'] &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['balance', 'totalEarnings', 'updatedAt']);
      allow delete: if false;

      // Voucher ອອກໂດຍ Cloud Function (Admin SDK) ເທົ່ານັ້ນ — client ອ່ານໄດ້
      // ແຕ່ຫ້າມຂຽນ ເພື່ອປ້ອງກັນການປອມສ່ວນຫຼຸດ
      match /vouchers/{voucherId} {
        allow read: if isAuth() && isOwner(uid);
        allow write: if false;
      }
    }

    match /referralCodes/{code} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /transactions/{txId} {
      allow read: if isAuth() && (resource.data.providerId == request.auth.uid || resource.data.customerId == request.auth.uid);
      // 🔒 [FOLLOWUP-1] ກ່ອນໜ້ານີ້ `allow create: if isAuth();` — provider ຄົນໃດ
      // ກໍໄດ້ສາມາດ inject ລາຍການ earning/bonus ປອມໃສ່ ledger ຂອງຕົນເອງໄດ້ໂດຍກົງ.
      // ຜູ້ຂຽນທີ່ຖືກຕ້ອງມີແຕ່ onBookingStatusChange (Admin SDK) ເທົ່ານັ້ນ.
      allow create: if false;
      // 🔒 [AUDIT SEC-1/SEC-2/ADM-1 / 2026-08-02] useApproveTopup ແລະ
      // useAdjustWalletBalance (lintho-admin) ຂຽນ ledger entry ປະເພດ
      // 'topup'/'adjustment' ພ້ອມກັນກັບການປັບ wallets.balance ຂ້າງເທິງ (ໃນ
      // transaction ດຽວກັນ) — ຕ້ອງເປັນ tier ດຽວກັນ (super_admin, finance_admin)
      // ຄືກັບ wallet:adjust/topups:approve.
      allow create: if getAdminRole() in ['super_admin', 'finance_admin'];
      allow update, delete: if false;
    }

    match /schedules/{uid} {
      allow read, write: if isAuth() && isOwner(uid);
    }

    match /withdrawalRequests/{reqId} {
      // 🔒 [AUDIT C4] ກ່ອນໜ້ານີ້ກວດແຕ່ isProvider() — provider ຄົນໜຶ່ງສາມາດ
      // ຍື່ນຄຳຂໍຖອນເງິນ "ໃນນາມ" providerId ຂອງຄົນອື່ນໄດ້ (ຖ້າຮູ້ uid). ຕອນນີ້
      // ບັງຄັບວ່າ providerId ໃນຄຳຂໍຕ້ອງເປັນຕົນເອງ ແລະ amount ຕ້ອງເປັນຕົວເລກ > 0.
      allow create: if isProvider() &&
        request.resource.data.providerId == request.auth.uid &&
        request.resource.data.amount is number && request.resource.data.amount > 0;
      allow read: if isAuth() && resource.data.providerId == request.auth.uid;
      // 🔒 [AUDIT SEC-1/SEC-2/ADM-1 / 2026-08-02] Admin approve/reject
      // (useApproveWithdrawal/useRejectWithdrawal/useUpdateWithdrawal,
      // lintho-admin) — ຕ້ອງເປັນ withdrawals:approve tier (super_admin,
      // finance_admin) ເທົ່ານັ້ນ. ກ່ອນໜ້ານີ້ admin tier ໃດກໍໄດ້ອະນຸມັດການຖອນເງິນ
      // ໄດ້ໂດຍກົງຜ່ານ blanket bypass.
      allow update: if getAdminRole() in ['super_admin', 'finance_admin'];
      allow delete: if false;
    }

    // 🔒 [Top-up] ຄຳຂໍຕື່ມເງິນ — pattern ດຽວກັນກັບ withdrawalRequests ຂ້າງເທິງ.
    // client ສ້າງໄດ້ແຕ່ status:'pending' ເທົ່ານັ້ນ, ຫ້າມແກ້ໄຂ/ລຶບຫຼັງສ້າງ — ການ
    // ອະນຸມັດ (ເພີ່ມ wallets.balance ຈິງ + ສ້າງ transactions ປະເພດ 'topup') ຕ້ອງ
    // ຜ່ານ Admin SDK ເທົ່ານັ້ນ (ຫຼັງ admin ກວດການໂອນຈິງຜ່ານທະນາຄານແລ້ວ) —
    // ບໍ່ດັ່ງນັ້ນ provider ຄົນໃດກໍໄດ້ຈະສາມາດຕັ້ງຄ່າ status:'completed' ເອງ ຫຼືອ້າງ
    // ວ່າໂອນເງິນແລ້ວ ໂດຍບໍ່ຕ້ອງໂອນຈິງ.
    match /topupRequests/{reqId} {
      allow create: if isProvider() &&
        request.resource.data.providerId == request.auth.uid &&
        request.resource.data.amount is number && request.resource.data.amount > 0 &&
        request.resource.data.status == 'pending';
      allow read: if isAuth() && resource.data.providerId == request.auth.uid;
      // 🔒 [AUDIT SEC-1/SEC-2/ADM-1 / 2026-08-02] Admin approve/reject
      // (useApproveTopup/useRejectTopup, lintho-admin) — ຕ້ອງເປັນ
      // topups:approve tier (super_admin, finance_admin) ເທົ່ານັ້ນ.
      allow update: if getAdminRole() in ['super_admin', 'finance_admin'];
      allow delete: if false;
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if false;
    }

    // Admin-managed discount codes (created from the LinTho web admin's
    // Promotions page). Clients only need to validate a code at checkout —
    // create/update (e.g. usedCount) goes through the admin bypass rule above.
    match /coupons/{couponId} {
      allow read: if true;
      // ✅ ລູກຄ້າ login ແລ້ວ increment usedCount ໄດ້ສະເພາະ field ນີ້ ຕອນຈອງ
      // ສຳເລັດ (ໃນ transaction ດຽວກັນກັບ booking creation) — ບໍ່ໃຫ້ແກ້ field ອື່ນ
      // (code/value/status/validFrom/...) ເພື່ອບໍ່ໃຫ້ລູກຄ້າປ່ຽນແປງ coupon ເອງ.
      // 🔒 [AUDIT H1] ກ່ອນໜ້ານີ້ບໍ່ໄດ້ກວດ usageLimit ຢູ່ນີ້ເລີຍ — ອາໄສແຕ່
      // client-side validate() ຢ່າງດຽວ (ອາດຫ່າງຈາກ submit ຫຼາຍນາທີ) ເຮັດໃຫ້
      // coupon ຖືກໃຊ້ເກີນ usageLimit ໄດ້ພາຍໃຕ້ concurrent redemption. ຕອນນີ້
      // ບັງຄັບຢູ່ rules ນຳ (defense-in-depth ຄຽງຄູ່ກັບ booking_repository.dart
      // ທີ່ re-validate ພາຍໃນ transaction ດຽວກັນແລ້ວ) — ອະນຸຍາດ increment
      // ສະເພາະຖ້າຍັງບໍ່ທັນຮອດ usageLimit (ຫຼືບໍ່ມີ usageLimit = ບໍ່ຈຳກັດ).
      // 🔒 [FOLLOWUP-4] ຄູປອງທີ່ໄດ້ຈາກການແລກແຕ້ມສ່ວນຕົວ (ownerId ບໍ່ວ່າງ) ກ່ອນໜ້ານີ້
      // ບໍ່ໄດ້ຖືກກວດຢູ່ນີ້ເລີຍ — ໃຜກໍໄດ້ທີ່ຮູ້ code (ຕົວຢ່າງ: screenshot ແບ່ງປັນ)
      // ສາມາດ increment usedCount ຂອງຄູປອງຄົນອື່ນໄດ້ກ່ອນເຈົ້າຂອງແທ້. ຕອນນີ້ບັງຄັບ
      // ວ່າຖ້າ ownerId ມີຄ່າ, ຕ້ອງເປັນຜູ້ໃຊ້ດຽວກັນນີ້ເທົ່ານັ້ນຈຶ່ງ increment ໄດ້.
      allow update: if isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount']) &&
        request.resource.data.usedCount == resource.data.usedCount + 1 &&
        (!('usageLimit' in resource.data) || resource.data.usageLimit == null ||
          resource.data.usedCount < resource.data.usageLimit) &&
        (!('ownerId' in resource.data) || resource.data.ownerId == null ||
          resource.data.ownerId == request.auth.uid);
      allow create, delete: if false;

      // 🔒 [AUDIT SEC-1/ADM-1 / 2026-08-02] Admin create/edit/delete coupon
      // (useCreateCoupon/useUpdateCoupon (via generic update)/useDeleteCoupon,
      // lintho-admin Promotions page) — ຕ້ອງເປັນ promotions:write/
      // promotions:delete tier (super_admin, marketing_admin) ເທົ່ານັ້ນ.
      allow create: if getAdminRole() in ['super_admin', 'marketing_admin'];
      allow update: if getAdminRole() in ['super_admin', 'marketing_admin'];
      allow delete: if getAdminRole() in ['super_admin', 'marketing_admin'];
    }

    // ລູກຄ້າສ້າງ request ແລກແຕ້ມ — onRewardRedemptionRequested (Cloud Function,
    // Admin SDK) ຈະກວດ rewardSettings + ຍອດແຕ້ມ ແລ້ວອອກ coupon/ຫັກແຕ້ມໃຫ້ແບບ
    // atomic. Client ຫ້າມແກ້ status/result ເອງ ເພື່ອບໍ່ໃຫ້ປອມຜົນແລກແຕ້ມ.
    match /rewardRedemptions/{reqId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.points is int && request.resource.data.points > 0 &&
        request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    // Ledger ແຕ້ມ (earn/redeem/manual) — ຂຽນໄດ້ສະເພາະ Cloud Function/Admin
    // ເທົ່ານັ້ນ, ລູກຄ້າອ່ານໄດ້ສະເພາະຂອງຕົນເອງ
    match /rewardTransactions/{txnId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.toUid == request.auth.uid;
      // 🔒 [FOLLOWUP-2] ກ່ອນໜ້ານີ້ `allow create: if isAuth();` ບໍ່ໄດ້ກວດ toUid
      // ເລີຍ — user ໃດກໍໄດ້ສາມາດຂຽນ notification ປອມໃສ່ feed ຄົນອື່ນ. Collection
      // ນີ້ບໍ່ຖືກໃຊ້ໂດຍ client code ໃດເລີຍໃນປັດຈຸບັນ (ແອັບໃຊ້ fcm_queue ແທນ) —
      // ຈຶ່ງປິດ create ໄວ້ທັງໝົດ ໃຫ້ຄືກັນກັບ rewardTransactions/vouchers
      // (Admin SDK ເທົ່ານັ້ນ), ຖ້າມີ feature ໃນອະນາຄົດຕ້ອງການຂຽນ ໃຫ້ຜ່ານ
      // Cloud Function ແທນ.
      allow create: if false;
      allow update: if isAuth() && resource.data.toUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if false;
    }

    match /kyc/{uid} {
      allow read, write: if isAuth() && isOwner(uid);
    }

    // 🔒 [FOLLOWUP-6] top-level `reviews/{reviewId}` ຖືກລຶບອອກ — ນີ້ແມ່ນ block
    // ທີ່ຄ້າງໄວ້ໂດຍບໍ່ມີການກວດຫຍັງເລີຍ (`allow create: if isAuth();`), ບໍ່ຖືກໃຊ້
    // ໂດຍ client code ໃດເລີຍ (grep ຢືນຢັນແລ້ວ) — ຣີວິວຈິງທັງໝົດຢູ່ subcollection
    // providers/{providerId}/reviews (ຂ້າງເທິງ, ຖືກ secure ຢ່າງຖືກຕ້ອງແລ້ວ).
    // ລຶບອອກເພື່ອບໍ່ໃຫ້ feature ໃນອະນາຄົດຫຼົງໄປຂຽນໃສ່ path ທີ່ບໍ່ປອດໄພນີ້.

    // 🔒 [FOLLOWUP-5] fcm_queue ບໍ່ເຄີຍມີ rule ມາກ່ອນເລີຍ — ຕົກໄປໃຊ້ default-deny,
    // ເຮັດໃຫ້ push notification ທີ່ client ສົ່ງເອງ (ຣີວິວ/ແຊັດ/ຄ່າໃຊ້ຈ່າຍເພີ່ມ,
    // ເບິ່ງ NotificationSender._send() ໃນ fcm_service.dart) ຖືກປະຕິເສດງຽບໆທຸກຄັ້ງ.
    // ອະນຸຍາດໃຫ້ user login ແລ້ວສ້າງ entry ໄດ້ (ຕ້ອງມີ targetUserId ແລະ sent==false
    // ສະເໝີ), ອ່ານ/ແກ້ໄຂ/ລຶບໄດ້ສະເພາະ Cloud Function (Admin SDK) ທີ່ processing queue.
    // 🔒 [AUDIT N-01 / 2026-08-08 — Critical, notification E2E audit] ຂ້າງເທິງນີ້
    // ອະນຸຍາດໃຫ້ user login ຄົນໃດກໍໄດ້ສ້າງ doc ໄດ້ໂດຍບໍ່ກວດວ່າເປັນ admin ຫຼືກ່ຽວຂ້ອງ
    // ກັບ targetUserId ຫຼືບໍ່ — ໝາຍຄວາມວ່າລູກຄ້າ/ຊ່າງຄົນໃດກໍໄດ້ສາມາດປອມແປງ
    // type:'admin_broadcast' ສົ່ງ push ຫາຜູ້ໃຊ້ຄົນອື່ນຄົນໃດກໍໄດ້ (processFCMQueue
    // ຈະສົ່ງ FCM ຈິງໂດຍບໍ່ກວດຫຍັງເພີ່ມ). ຕອນນີ້ຈຳກັດ create ໃຫ້ພຽງ 2 ເສັ້ນທາງ:
    // (1) isAdmin() — Admin Panel broadcast/specific/role send (useSendNotification,
    // lintho-admin), ຫຼື (2) fcmBookingAuthorized() — client-side flow ທີ່ຜູກກັບ
    // booking ຈິງ ແລະ type ຢູ່ໃນ allow-list ຂອງ 3 flow ທີ່ໃຊ້ຈິງເທົ່ານັ້ນ
    // (chat/review/additional_charges — ເບິ່ງ NotificationSender ໃນ fcm_service.dart).
    match /fcm_queue/{queueId} {
      allow create: if isAuth() &&
        request.resource.data.sent == false &&
        request.resource.data.targetUserId is string &&
        (
          isAdmin() ||
          (
            request.resource.data.type in ['chat', 'review', 'additional_charges'] &&
            fcmBookingAuthorized(request.resource.data.bookingId, request.resource.data.targetUserId)
          )
        );
      allow read, update, delete: if false;
    }

    // 🔒 [AUDIT M1] ບໍ່ມີ match block ນີ້ມາກ່ອນ — chat_screen.dart ອ່ານ/ຂຽນ
    // collection('chats') (members-array query ຢູ່ chat_screen.dart:78-80,
    // ChatService.createOrGetChat ຢູ່ chat_screen.dart:840-878) ໂດຍບໍ່ມີ rule
    // ສະເພາະ, ຈຶ່ງຕົກໄປໃຊ້ admin bypass rule ຢ່າງດຽວ (deny ສຳລັບ user ທຳມະດາ).
    // doc ແມ່ນ metadata ຫ້ອງແຊັດ (bookingId, customerId, providerId, members:
    // [customerId, providerId], lastMessage, lastMessageAt, createdAt) —
    // ຂໍ້ຄວາມແຊັດຈິງເກັບໃນ Realtime Database ແຍກຕ່າງຫາກ (ບໍ່ຢູ່ໃນ scope ຂອງ
    // ໄຟລ໌ນີ້). ອະນຸຍາດອ່ານ/ຂຽນສະເພາະ 2 ຄົນທີ່ຢູ່ໃນ members ເທົ່ານັ້ນ, ແລະ
    // update ຫ້າມແກ້ໄຂ members (ຫ້າມ member ປັດປ່ຽນ/ໄລ່ອີກຝ່າຍອອກ).
    match /chats/{chatId} {
      allow read: if isAuth() && request.auth.uid in resource.data.members;

      allow create: if isAuth() &&
        request.resource.data.members is list &&
        request.resource.data.members.size() == 2 &&
        request.auth.uid in request.resource.data.members;

      allow update: if isAuth() && request.auth.uid in resource.data.members &&
        request.resource.data.members == resource.data.members &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastMessageAt']);

      allow delete: if false;
    }
  }
}
